!tests/fixtures/mh_wellbeing/**
# Event index tests, the v0.2.1 reference projection, golden scenario and benchmarks (tracked)
!tests/test_index_*.py
!tests/index_support.py
!tests/reference_projection.py
!tests/golden/
tests/golden/*
